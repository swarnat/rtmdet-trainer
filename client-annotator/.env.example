# Access token for the web UI and the training system (at least 16 characters), e.g. openssl rand -hex 32
CLIENT_ACCESS_TOKEN=
CLIENT_ANNOTATOR_PORT=8200
CLIENT_ANNOTATOR_IMAGE=swarnat/rtmdet-client-annotator
CLIENT_ANNOTATOR_TAG=latest
MAX_UPLOAD_MB=50
# Optional proxy for the batch download, e.g. http://proxy-host:8888
DOWNLOAD_PROXY=
# Optional confidence for checks against the inference server (e.g. 0.4); set: overrides the value pushed by the
# training system (default_confidence), empty: the pushed value applies
CHECK_CONFIDENCE=
LOG_LEVEL=INFO
