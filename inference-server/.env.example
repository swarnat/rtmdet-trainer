# Copy to .env. Generate a key e.g. with:  openssl rand -hex 32
# The same key is entered in the training system under Einstellungen → Produktivsystem.
MODEL_UPLOAD_KEY=

# Image (built with `make inference-server`, optionally pushed to a registry)
INFERENCE_IMAGE=swarnat/rtmdet-detection
INFERENCE_TAG=latest

# Port of the detection API on the host
INFERENCE_PORT=8100

# Lowest confidence of a detection (default threshold of /detect)
MIN_CONFIDENCE=0.15
OPENVINO_DEVICE=CPU
MAX_UPLOAD_MB=50
MAX_MODEL_UPLOAD_MB=1024
LOG_LEVEL=INFO
